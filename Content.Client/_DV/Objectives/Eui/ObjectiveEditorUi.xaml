<controls:FancyWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    Title="{Loc objective-editor-admin-ui-title}"
    MinSize="800 400"
>
    <BoxContainer Orientation="Vertical">
        <BoxContainer Orientation="Horizontal">
            <BoxContainer Orientation="Horizontal" Align="Begin" >
                <Button Name="DeleteAllButton" Text="{Loc objective-editor-admin-ui-delete-all}" StyleClasses="OpenRight"/>
            </BoxContainer>
            <BoxContainer Orientation="Horizontal" Align="End">
                <Button Name="NewObjectiveButton" Text="{Loc objective-editor-admin-ui-new-objective}" StyleClasses="OpenRight"/>
                <Button Name="ResetButton" Text="{Loc objective-editor-admin-ui-reset}" StyleClasses="OpenBoth"/>
                <Button Name="SaveButton" Text="{Loc objective-editor-admin-ui-save}" Access="Public" StyleClasses="OpenLeft"/>
            </BoxContainer>
        </BoxContainer>
    </BoxContainer>
    <BoxContainer Orientation="Vertical" Margin="4 60 0 0">
        <ScrollContainer VerticalExpand="True" HorizontalExpand="True" HScrollEnabled="False">
            <BoxContainer Orientation="Vertical" Name="ObjectiveContainer" VerticalExpand="True" />
        </ScrollContainer>
    </BoxContainer>
</controls:FancyWindow>
