<controls:FancyWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    Title="{Loc objective-editor-admin-ui-title}"
    MinSize="800 400"
>
    <BoxContainer Orientation="Vertical" >
        <BoxContainer Orientation="Horizontal" Align="End">
            <Button Name="DeleteAllButton" Text="{Loc objective-editor-admin-ui-delete-all}" StyleClasses="OpenRight"  ModulateSelfOverride="Red" />
            <Button Name="NewObjectiveButton" Text="{Loc objective-editor-admin-ui-new-objective}" StyleClasses="OpenBoth"/>
            <Button Name="ResetButton" Text="{Loc objective-editor-admin-ui-reset}" StyleClasses="OpenBoth"/>
            <Button Name="SaveButton" Text="{Loc objective-editor-admin-ui-save}" Access="Public" StyleClasses="OpenLeft"/>
        </BoxContainer>

        <TabContainer Name="ObjectiveContainer"  />
    </BoxContainer>
</controls:FancyWindow>
