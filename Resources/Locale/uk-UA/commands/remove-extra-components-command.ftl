cmd-removeextracomponents-desc = Видаляє всі компоненти з усіх сутностей із вказаним ідентифікатором, якщо цього компонента немає в його прототипі.\nЯкщо ідентифікатор не вказано, він відповідає всім сутностям.
cmd-removeextracomponents-help = removeextracomponents / removeextracomponents <entityId>
cmd-removeextracomponents-invalid-prototype-id = Не вдається знайти прототип сутності з ідентифікатором {$id}.
cmd-removeextracomponents-success = Вилучено {$count}компонентів з {$entities},
cmd-removeextracomponents-success-with-id = Видалено {$count}компонентів з {$entities}з ідентифікатором {$id}.