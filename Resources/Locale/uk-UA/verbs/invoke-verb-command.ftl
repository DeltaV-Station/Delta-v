### Localization used for the invoke verb command.
# Mostly help + error messages.

invoke-verb-command-description = Викликає дієслово з заданим іменем на сутності з сутністю гравця
invoke-verb-command-help = invokeverb <playerUid | "self"> <targetUid> <verbName | «взаємодія» | "активація" | "альтернатива">

invoke-verb-command-invalid-args = invokeverb приймає 2 аргументи.

invoke-verb-command-invalid-player-uid = UID гравця не вдалося проаналізувати, або "self" не було передано.
invoke-verb-command-invalid-target-uid = Цільовий UID не вдалося проаналізувати.

invoke-verb-command-invalid-player-entity = Наданий uid гравця не відповідає дійсному об’єкту.
invoke-verb-command-invalid-target-entity = Наданий ідентифікатор цілі не відповідає дійсному об’єкту.

invoke-verb-command-success = Викликано дієслово '{ $verb }' на { $target } з { $player } як користувач.

invoke-verb-command-verb-not-found = Не вдалося знайти дієслово { $verb } на { $target }.