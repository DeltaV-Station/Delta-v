### Localization used for the list verbs command.
# Mostly help + error messages.

list-verbs-command-description = Перелічує всі дієслова, які гравець може використовувати для даної сутності.
list-verbs-command-help = listverbs <playerUid | "self"> <targetUid>

list-verbs-command-invalid-args = listverbs приймає 2 аргументи.

list-verbs-command-invalid-player-uid = UID гравця не вдалося проаналізувати, або "self" не було передано.
list-verbs-command-invalid-target-uid = Цільовий UID не вдалося проаналізувати.

list-verbs-command-invalid-player-entity = Наданий uid гравця не відповідає дійсному об’єкту.
list-verbs-command-invalid-target-entity = Наданий ідентифікатор цілі не відповідає дійсному об’єкту.

list-verbs-verb-listing = { $type }: { $verb }