# FTLdiskburner
cmd-ftldisk-desc = Створює диск з координатами FTL, щоб перейти до карти, на якій знаходиться даний EntityID
cmd-ftldisk-help = ftldisk [EntityID]

cmd-ftldisk-no-transform = Сутність {$destination}не має компонента трансформації!
cmd-ftldisk-no-map = Об’єкт {$destination}не має карти!
cmd-ftldisk-no-map-comp = Сутність {$destination}якимось чином знаходиться на карті {$map}без компонента карти.
cmd-ftldisk-map-not-init = Сутність {$destination}знаходиться на карті {$map}, яка не ініціалізована! Перевірте, чи безпечно ініціалізувати, а потім спочатку ініціалізуйте карту, інакше гравці залишаться на місці!
cmd-ftldisk-map-paused = Сутність {$desintation}знаходиться на карті {$map}, яка призупинена! Будь ласка, спочатку призупиніть карту, інакше гравці залишаться на місці.
cmd-ftldisk-planet = Ви не можете використовувати цю команду без сутності.
cmd-ftldisk-already-dest-not-enabled = Сутність {$destination}знаходиться на карті {$map}, яка вже має FTLDestinationComponent, але вона не ввімкнена! Встановіть це вручну для безпеки.
cmd-ftldisk-requires-ftl-point = Сутність {$destination}знаходиться на карті {$map}, для подорожі до якої потрібна точка FTL! Можливо, воно вже існує.

cmd-ftldisk-hint = Карта netID