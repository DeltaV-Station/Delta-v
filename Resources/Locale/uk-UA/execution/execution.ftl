execution-verb-name = Виконати
execution-verb-message = Використовуйте свою зброю, щоб стратити когось.

# All the below localisation strings have access to the following variables
# attacker (the person committing the execution)
# victim (the person being executed)
# weapon (the weapon used for the execution)

execution-popup-gun-initial-internal = Ви приставляєте дуло {THE($weapon)} до голови {THE($victim)}.
execution-popup-gun-initial-external = {CAPITALIZE(THE($attacker))} налаштовує дуло {THE($weapon)} на голову {THE($victim)}.
execution-popup-gun-complete-internal = Ви розбиваєте {THE($victim)} в голову!
execution-popup-gun-complete-external = {CAPITALIZE(THE($attacker))} б'є {THE($victim)} в голову!
execution-popup-gun-clumsy-internal = Ви промахнулися головою {THE($victim)} і натомість прострелили свою ногу!
execution-popup-gun-clumsy-external = {CAPITALIZE(THE($attacker))} промахнувся {THE($victim)} і натомість стріляв у ногу {POSS-ADJ($attacker)}!
execution-popup-gun-empty = {CAPITALIZE(THE($weapon))} кліків.

execution-popup-melee-initial-internal = Ви готові {THE($weapon)} проти горла {THE($victim)}.
execution-popup-melee-initial-external = { CAPITALIZE(THE($attacker))} готує {POSS-ADJ($attacker)} {$weapon}до горла {THE($victim)}.
execution-popup-melee-complete-internal = Ви перерізали горло {THE($victim)}!
execution-popup-melee-complete-external = { CAPITALIZE(THE($attacker)) } перерізає горло {THE($victim)}!

execution-popup-self-initial-internal = Ти готовий {THE($weapon)} проти власного горла.
execution-popup-self-initial-external = { CAPITALIZE(THE($attacker)) } готує {POSS-ADJ($attacker)} {$weapon}до власного горла.
execution-popup-self-complete-internal = Ти перерізав собі горло!
execution-popup-self-complete-external = { CAPITALIZE(THE($attacker)) } перерізає собі горло!