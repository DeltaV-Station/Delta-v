# ============================================================
# УКРАЇНСЬКІ ГРАМАТИЧНІ ФУНКЦІЇ
# ============================================================

# UKPLURAL - множина
# Використання: { UKPLURAL($count, "предмет", "предмети", "предметів") }
# Приклад: 1 предмет, 2 предмети, 5 предметів, 21 предмет

# UKGENDER - рід
# Використання: { UKGENDER($gender, "взяв", "взяла", "взяло") }
# Приклад: Іван взяв, Марія взяла

# UKCASE - відмінки
# Використання: { UKCASE("dative", "гравець", "гравця", "гравцю") }
# Відмінки: nominative, genitive, dative, accusative, instrumental, locative

# UKPLURALGEN - множина + рід (комбінована)
# Використання: { UKPLURALGEN($count, $gender, "взяв/взяла/взяло", "взяли/взяли/взяли", "взяли/взяли/взяли") }
# Приклад: 1 гравець взяв, 1 гравчиня взяла, 2 гравці взяли

# UKTIME - форматування часу
# Використання: { UKTIME($hours, $minutes) }
# Приклад: 2 години 30 хвилин, 1 година 5 хвилин

# UKLIST - форматування списку
# Використання: { UKLIST("яблуко", "груша", "банан") }
# Приклад: яблуко, груша та банан

# UKNAME - автоматичне відмінювання імен
# Використання: { UKNAME("accusative", $name) }
# Приклад: Іван -> Івана, Марія -> Марію, Петро -> Петра
# Відмінки: nominative, genitive, dative, accusative, instrumental, locative
# Працює з повними іменами: "Іван Петренко" -> "Івана Петренка"
# Підтримує імена з дефісом (унаті): "Ssi-Ka" -> "Ssi-Ку"
#
# Приклади використання:
# { UKNAME("nominative", $user) } обіймає { UKNAME("accusative", $target) }
# Результат: Іван обіймає Марію
#
# { UKNAME("nominative", $user) } затримує { UKNAME("accusative", $target) }
# Результат: Петро затримує Софію
#
# Операція на { UKNAME("genitive", $target) }
# Результат: Операція на Івана

# ============================================================
# СУМІСНІСТЬ З АНГЛІЙСЬКИМИ ФУНКЦІЯМИ
# ============================================================

# SUBJECT - називний відмінок (хто? що?)
# Використання: { SUBJECT($entity) }
# Приклад: Іван, Марія

# OBJECT - знахідний відмінок (кого? що?)
# Використання: { OBJECT($entity) }
# Приклад: Івана, Марію

# POSS-ADJ - присвійний прикметник (чий? чия? чиє?)
# Використання: { POSS-ADJ($entity) }
# Приклад: його, її

# POSS-PRONOUN - присвійний займенник
# Використання: { POSS-PRONOUN($entity) }
# Приклад: його, її

# REFLEXIVE - зворотний займенник (себе, собі, собою)
# Використання: { REFLEXIVE($entity) }
# Приклад: себе

# CONJUGATE-BE - дієслово "бути"
# Використання: { CONJUGATE-BE($entity) }
# Приклад: є

# CONJUGATE-BASIC - базове дієвідмінювання
# Використання: { CONJUGATE-BASIC($entity, "singular", "plural") }
# Приклад: має, мають

# PROPER - власне ім'я (з великої літери)
# Використання: { PROPER($entity) }
# Приклад: Іван, Марія

# ПРИМІТКА: Для кращої підтримки української граматики рекомендується
# використовувати UKNAME замість SUBJECT/OBJECT, оскільки UKNAME
# підтримує всі відмінки та правильно обробляє українські імена.

