set-game-preset-command-description = Встановлює налаштування гри для вказаної кількості майбутніх раундів. Також може відображати назву й опис іншого стилю в лобі, щоб обдурити гравців.
set-game-preset-command-help-text = setgamepreset <id> [кількість раундів, за замовчуванням 1] [decoy preset]
set-game-preset-command-hint-1 = <id>
set-game-preset-command-hint-2 = [number of rounds]
set-game-preset-command-hint-3 = [decoy preset]

set-game-preset-optional-argument-not-integer = Якщо вказано аргумент 2, це має бути число.
set-game-preset-preset-error = Не вдається знайти стиль гри "{$preset}"
set-game-preset-decoy-error = Якщо надано аргумент 3, він має бути дійсним попереднім налаштуванням. Не вдається знайти стиль гри "{$preset}"

#set-game-preset-preset-set = Set game preset to "{$preset}"
set-game-preset-preset-set-finite = Встановіть налаштування гри на "{$preset}" для наступних {$rounds}раундів.
set-game-preset-preset-set-finite-with-decoy = Встановіть налаштування гри на «{$preset}» для наступних {$rounds}раундів, показуючи {$decoy}у лобі.