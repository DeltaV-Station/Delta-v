cmd-mute_ooc-desc = Mutes or unmutes the specified player in global OOC chat. The mute will persist until the server restarts.
cmd-mute_ooc-help = Usage: {$command} [username]
cmd-mute_ooc-err-no-data = Unable to get content player data for {$player}.

cmd-mute_looc-desc = Mutes or unmutes the specified player in LOOC chat. The mute will not persist across rounds.
cmd-mute_looc-help = Usage: {$command} [username]

cmd-mute_deadchat-desc = Mutes or unmutes the specified player in Deadchat. The mute will not persist across rounds.
cmd-mute_deadchat-help = Usage: {$command} [username]

ooc-mute-cmds-err-missing-mind = The specified player lacks a Mind.

ooc-mute-cmds-player-notif-muted = You have been muted in {$chat}.
ooc-mute-cmds-player-notif-unmuted = You have been unmuted in {$chat}.
